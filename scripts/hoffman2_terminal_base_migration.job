#!/usr/bin/env bash
set -euo pipefail

# Frozen one-slot compute-node wrapper for the authoritative base-belief migration.

export LANG=C
export LC_ALL=C
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
unset PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONHOME

: "${STAGE_ROOT:?}"
: "${RUN_DIR:?}"
: "${APPROVAL_PATH:?}"
: "${APPROVAL_HASH:?}"
: "${PYTHON_BIN:?}"
: "${CONDA_SH:?}"
: "${CONDA_ENV_PATH:?}"
: "${FROZEN_JOB_SCRIPT:?}"

if [[ "${NSLOTS:-}" != "1" ]]; then
  echo "The migration requires exactly one scheduler slot." >&2
  exit 2
fi
if [[ ! "${JOB_ID:-}" =~ ^[0-9]+$ || "${JOB_ID}" == "0" ]]; then
  echo "The migration requires a nonempty positive numeric JOB_ID." >&2
  exit 2
fi
HOST_FQDN="$(hostname -f 2>/dev/null || hostname)"
if [[ "${HOST_FQDN%%.*}" == login* ]]; then
  echo "The migration must run on a compute node, not a login node." >&2
  exit 2
fi

source "${CONDA_SH}"
conda activate "${CONDA_ENV_PATH}"
if [[ "$(readlink -f "$(command -v python)")" != "$(readlink -f "${PYTHON_BIN}")" ]]; then
  echo "Activated Python does not match the approved Python executable." >&2
  exit 2
fi
unset PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONHOME

ARTIFACT="${RUN_DIR}/terminal_base_beliefs.candidate.json"
SEMANTIC_HASH_FILE="${RUN_DIR}/semantic_output_hash.txt"
ARTIFACT_HASH_FILE="${RUN_DIR}/artifact_sha256.txt"
JOB_EVIDENCE="${RUN_DIR}/job_evidence.json"
for path in "${ARTIFACT}" "${SEMANTIC_HASH_FILE}" "${ARTIFACT_HASH_FILE}" "${JOB_EVIDENCE}"; do
  if [[ -e "${path}" ]]; then
    echo "Refusing to reuse migration evidence path: ${path}" >&2
    exit 2
  fi
done

cd "${STAGE_ROOT}"
if [[ "$(git rev-parse HEAD)" != "7376c5d70cf2520600894853e2a1275e8d0a89e1" ]]; then
  echo "Wrong authoritative commit." >&2
  exit 2
fi
if [[ "$(git rev-parse 'HEAD^{tree}')" != "87100610dfea58375147f7c5064430f5a77d5926" ]]; then
  echo "Wrong authoritative tree." >&2
  exit 2
fi
git diff --quiet HEAD --
git diff --cached --quiet HEAD --

START_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
SEMANTIC_HASH="$(
  "${PYTHON_BIN}" scripts/export_terminal_base_migration.py \
    --output "${ARTIFACT}" \
    --manifest results/r6_prefeedback_quadrature_7376c5d_v1/r6_quadrature_diagnostic_manifest.json \
    --execution-approval "${APPROVAL_PATH}" \
    --execution-approval-file-hash "${APPROVAL_HASH}" \
    --scheduled-job-script "${FROZEN_JOB_SCRIPT}"
)"
if [[ ! "${SEMANTIC_HASH}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "Exporter did not print one semantic SHA-256." >&2
  exit 2
fi
ARTIFACT_HASH="$(sha256sum "${ARTIFACT}" | awk '{print $1}')"
END_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

set -o noclobber
printf '%s\n' "${SEMANTIC_HASH}" > "${SEMANTIC_HASH_FILE}"
printf '%s\n' "${ARTIFACT_HASH}" > "${ARTIFACT_HASH_FILE}"
"${PYTHON_BIN}" - \
  "${ARTIFACT}" "${JOB_EVIDENCE}" "${SEMANTIC_HASH}" "${ARTIFACT_HASH}" \
  "${HOST_FQDN}" "${JOB_ID:-}" "${NSLOTS}" "${START_UTC}" "${END_UTC}" \
  "${APPROVAL_HASH}" "$(readlink -f "${PYTHON_BIN}")" <<'PY'
import json
import os
from pathlib import Path
import sys

(
    artifact_path,
    evidence_path,
    semantic_hash,
    artifact_hash,
    hostname,
    job_id,
    slots,
    start_utc,
    end_utc,
    approval_hash,
    python_executable,
) = sys.argv[1:]
artifact = json.loads(Path(artifact_path).read_text(encoding="utf-8"))
evidence = {
    "schema": "terminal_base_migration_job_evidence_v2",
    "artifact_file": Path(artifact_path).name,
    "artifact_sha256": artifact_hash,
    "semantic_output_hash": semantic_hash,
    "artifact_semantic_output_hash": artifact["output_hash"],
    "execution_approval_file_hash": approval_hash,
    "python_executable": python_executable,
    "runtime_identity": artifact["runtime_identity"],
    "dependency_identity": artifact["dependency_identity"],
    "migration_tool_hashes": artifact["migration_tool_hashes"],
    "hostname": hostname,
    "canonical_hostname": hostname.strip().rstrip(".").lower().split(".", 1)[0],
    "job_id": job_id,
    "slots": int(slots),
    "start_utc": start_utc,
    "end_utc": end_utc,
}
if semantic_hash != artifact["output_hash"]:
    raise SystemExit("printed semantic hash does not match artifact")
with Path(evidence_path).open("x", encoding="utf-8") as handle:
    json.dump(evidence, handle, indent=2, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
