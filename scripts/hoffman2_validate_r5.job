set -euo pipefail
source /u/local/Modules/default/init/bash
module load python/3.9.6
export LANG=C
unset LC_ALL

python3 -m unittest discover -s tests
python3 -m json.tool notebooks/run_round5_pipeline.ipynb >/dev/null

echo "Round 5 tests and notebook validation passed."
