#!/usr/bin/env bash
set -euo pipefail

# Immutable one-slot probe for the exact Hoffman2 runtime/dependency approval profile.

export LANG=C
export LC_ALL=C
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
unset PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONHOME

: "${RUN_DIR:?}"
: "${PYTHON_BIN:?}"
: "${CONDA_SH:?}"
: "${CONDA_ENV_PATH:?}"
: "${FROZEN_JOB_SCRIPT:?}"

if [[ "${NSLOTS:-}" != "1" ]]; then
  echo "The runtime probe requires exactly one scheduler slot." >&2
  exit 2
fi
if [[ ! "${JOB_ID:-}" =~ ^[0-9]+$ || "${JOB_ID}" == "0" ]]; then
  echo "The runtime probe requires a positive numeric JOB_ID." >&2
  exit 2
fi
HOST_FQDN="$(hostname -f 2>/dev/null || hostname)"
if [[ "${HOST_FQDN%%.*}" == login* ]]; then
  echo "The runtime probe must run on a compute node." >&2
  exit 2
fi

source "${CONDA_SH}"
conda activate "${CONDA_ENV_PATH}"
if [[ "$(readlink -f "$(command -v python)")" != "$(readlink -f "${PYTHON_BIN}")" ]]; then
  echo "Activated Python does not match PYTHON_BIN." >&2
  exit 2
fi
unset PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONHOME

PROFILE="${RUN_DIR}/runtime_profile.candidate.json"
PROFILE_HASH_FILE="${RUN_DIR}/runtime_profile_sha256.txt"
JOB_EVIDENCE="${RUN_DIR}/runtime_probe_job_evidence.json"
for path in "${PROFILE}" "${PROFILE_HASH_FILE}" "${JOB_EVIDENCE}"; do
  [[ ! -e "${path}" ]] || { echo "Refusing to reuse runtime-probe path: ${path}" >&2; exit 2; }
done

START_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
"${PYTHON_BIN}" - "${PROFILE}" <<'PY'
from importlib import metadata
import json
import os
from pathlib import Path
import platform
import sys

profile_path = Path(sys.argv[1])
dependencies = {}
for package in ("numpy", "scipy"):
    try:
        dependencies[package] = metadata.version(package)
    except metadata.PackageNotFoundError as error:
        raise SystemExit(f"required dependency is absent: {package}") from error
runtime = {
    "byteorder": sys.byteorder,
    "libc": "|".join(platform.libc_ver()),
    "platform_machine": platform.machine(),
    "platform_release": platform.release(),
    "platform_system": platform.system(),
    "python_build": "|".join(platform.python_build()),
    "python_executable": str(Path(sys.executable).resolve()),
    "python_implementation": platform.python_implementation(),
    "python_version": platform.python_version(),
}
profile = {
    "schema": "terminal_base_migration_runtime_profile_v1",
    "runtime_identity": [list(item) for item in sorted(runtime.items())],
    "dependency_identity": [list(item) for item in sorted(dependencies.items())],
}
with profile_path.open("x", encoding="utf-8") as handle:
    json.dump(profile, handle, indent=2, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
PROFILE_HASH="$(sha256sum "${PROFILE}" | awk '{print $1}')"
JOB_SCRIPT_HASH="$(sha256sum "${FROZEN_JOB_SCRIPT}" | awk '{print $1}')"
END_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

set -o noclobber
printf '%s\n' "${PROFILE_HASH}" > "${PROFILE_HASH_FILE}"
"${PYTHON_BIN}" - \
  "${JOB_EVIDENCE}" "${PROFILE_HASH}" "${JOB_SCRIPT_HASH}" \
  "$(readlink -f "${PYTHON_BIN}")" "${HOST_FQDN}" "${JOB_ID}" "${NSLOTS}" \
  "${START_UTC}" "${END_UTC}" <<'PY'
import json
import os
from pathlib import Path
import sys

(
    evidence_path,
    profile_hash,
    job_script_hash,
    python_executable,
    hostname,
    job_id,
    slots,
    start_utc,
    end_utc,
) = sys.argv[1:]
evidence = {
    "schema": "terminal_runtime_profile_probe_job_evidence_v1",
    "profile_file": "runtime_profile.candidate.json",
    "profile_sha256": profile_hash,
    "job_script_sha256": job_script_hash,
    "python_executable": python_executable,
    "hostname": hostname,
    "canonical_hostname": hostname.strip().rstrip(".").lower().split(".", 1)[0],
    "job_id": job_id,
    "slots": int(slots),
    "start_utc": start_utc,
    "end_utc": end_utc,
}
with Path(evidence_path).open("x", encoding="utf-8") as handle:
    json.dump(evidence, handle, indent=2, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
